{
  "name": "@seltra/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Seltra off-chain services: orderbook API, matching engine, price watcher, keeper bot, indexer",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "api": "tsx src/api.ts",
    "keeper": "tsx src/keeper.ts",
    "arb": "tsx src/arbBot.ts",
    "arb:dry-run": "tsx src/arbBot.ts --once",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "^10.0.1",
    "ethers": "^6.13.0",
    "fastify": "^4.28.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
