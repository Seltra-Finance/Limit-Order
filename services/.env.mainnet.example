# Seltra Avalanche mainnet service template. Public values only; inject secrets
# with the host secret manager. Startup fails closed until every placeholder and
# mainnet confirmation gate is set.
CHAIN_ID=43114
RPC_URL=https://YOUR_AUTHENTICATED_AVALANCHE_RPC
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
SETTLEMENT=0xREPLACE_AFTER_DEPLOYMENT
ROUTER=0xREPLACE_AFTER_DEPLOYMENT

PAIRS={"WAVAX/USDC":{"base":"0xB31f66AA3C1e785363F0875A1B74E27b85FD66c7","quote":"0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E"},"USDC/USDt":{"base":"0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E","quote":"0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7"}}
DEX_VENUES=[{"kind":"lfj","name":"LFJ","adapterId":1,"quoter":"0xd76019A16606FDa4651f636D9751f500Ed776250"},{"kind":"blackhole","name":"Blackhole","adapterId":2,"routes":{"WAVAX/USDC":{"pool":"0x41100C6D2c6920B10d12Cd8D59c8A9AA2eF56fC7","stable":false,"concentrated":true},"USDC/USDt":{"pool":"0x859592A4A469610E573f96Ef87A0e5565F9a94c8","stable":false,"concentrated":true}}},{"kind":"pharaoh","name":"Pharaoh","adapterId":3,"routes":{"WAVAX/USDC":{"tickSpacing":10},"USDC/USDt":{"tickSpacing":1}}}]

DATABASE_URL=postgresql://seltra:REPLACE@127.0.0.1:5432/seltra
INDEXER_START_BLOCK=REPLACE_WITH_DEPLOYMENT_BLOCK
INDEXER_CONFIRMATIONS=2
INDEXER_BATCH_SIZE=2000

API_HOST=127.0.0.1
API_PORT=8080
CORS_ORIGIN=https://docs-or-app.seltra.finance
API_RATE_LIMIT_PER_MINUTE=120
POLL_INTERVAL_MS=2000
QUOTE_DEADLINE_SECONDS=30
MAX_QUOTE_AGE_MS=5000

# Both launch-pair quote tokens use 6 decimals: $5,000/order and $50,000/day.
KEEPER_MIN_PROFIT=250000
MIN_ORDER_NOTIONAL=1000000
MAX_ORDER_TTL_SECONDS=2592000
KEEPER_MAX_ORDER_NOTIONAL=5000000000
KEEPER_DAILY_NOTIONAL_CAP=50000000000
WRAPPED_NATIVE=0xB31f66AA3C1e785363F0875A1B74E27b85FD66c7
GAS_COST_BUFFER_BPS=2000

MAINNET_CONFIRM=SELTRA_MAINNET_CONFIG_REVIEWED
# Inject only when the keeper is deliberately enabled:
# KEEPER_PRIVATE_KEY=0x...
# KEEPER_CONFIRM_LIVE=EXECUTE_REAL_MAINNET_ORDER_FILLS
