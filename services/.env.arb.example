# Seltra isolated cross-DEX arbitrage service. Dry-run is the default and
# cannot submit transactions even if a key is present.
ARB_MODE=dry-run
ARB_CHAIN_ID=43114
ARB_RPC_URLS=https://api.avax.network/ext/bc/C/rpc

# Each cycle is tokenIn -> tokenMid -> tokenIn. Amounts and minimum profit are
# raw token units. Live MVP cycles must start with WAVAX so native gas
# accounting cannot fail after a transaction is mined.
ARB_CYCLES='[{"name":"WAVAX-USDC","tokenIn":"0xB31f66AA3C1e785363F0875A1B74E27b85FD66c7","tokenMid":"0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E","amountIn":"1000000000000000000","minNetProfit":"500000000000000"}]'

ARB_LFJ_ROUTER=0xb4315e873dBcf96Ffd0acd8EA43f689D8c20fB30
ARB_LFJ_QUOTER=0xd76019A16606FDa4651f636D9751f500Ed776250
ARB_PHARAOH_ROUTER=0xc8B8fCbDb5C019D7802fFb0b39603395D7d3915c
ARB_PHARAOH_QUOTER=0xB7297301b7CC659BB96D51754643A0Df6eEA2138
ARB_PHARAOH_TICK_SPACING=10
ARB_SLIPPAGE_BPS=30
ARB_DEADLINE_SECONDS=30
ARB_ESTIMATED_GAS_UNITS=650000
ARB_GAS_COST_BUFFER_BPS=2000
ARB_MAX_FEE_GWEI=100
ARB_MAX_QUOTE_AGE_MS=5000
ARB_POLL_INTERVAL_MS=3000
ARB_COOLDOWN_MS=30000
ARB_MAX_CONSECUTIVE_FAILURES=5
ARB_FAILURE_PAUSE_MS=60000
ARB_JOURNAL_PATH=data/arbitrage.jsonl
# ARB_ALERT_WEBHOOK_URL=https://hooks.example/...

# Live mode is intentionally triple-gated. Do not set these in dry-run. The
# executor must already be deployed, allowlisted, unpaused and independently
# reviewed. The operator should be a dedicated hot key holding gas only.
# ARB_MODE=live
# ARB_CONFIRM_LIVE=EXECUTE_REAL_MAINNET_TRADES
# ARB_EXECUTOR=0x...
# ARB_OPERATOR_PRIVATE_KEY=0x...
