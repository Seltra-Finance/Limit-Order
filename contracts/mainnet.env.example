# Public Avalanche mainnet deployment inputs. Never store PRIVATE_KEY here.
# Recommended production sequence:
# 1. Deploy/configure a Safe with at least a 2-signature threshold.
# 2. Governance.s.sol:Governance --sig deployTimelockOnly() with the Safe as
#    PROPOSER, EXECUTOR and GUARDIAN.
# 3. Dry-run Deploy.s.sol with OWNER=that timelock, then broadcast only after
#    bytecode/address review.
# 4. Safe path: PrepareGovernanceOwnership.s.sol generates schedule/execute
#    payloads. Bootstrap EOA path: Governance.scheduleOwnership() broadcasts
#    the schedules directly. Wait >=48h, execute, then run service preflight.

DEPLOYER=0xREPLACE_WITH_DEPLOYER_EOA
OWNER=0xREPLACE_WITH_TIMELOCK
GUARDIAN=0xREPLACE_WITH_SAFE
TREASURY=0xREPLACE_WITH_SAFE
DEPLOY_MOCK_ADAPTER=false
DEPLOY_BLACKHOLE_ADAPTER=true

LFJ_LB_ROUTER=0x18556DA13313f3532c54711497A8FedAC273220E
