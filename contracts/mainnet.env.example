# Public Avalanche mainnet deployment inputs. Never store PRIVATE_KEY here.
# Production sequence:
# 1. Deploy/configure a Safe with at least a 2-signature threshold.
# 2. Governance.s.sol:Governance --sig deployTimelockOnly() with the Safe as
#    PROPOSER and EXECUTOR.
# 3. Dry-run Deploy.s.sol with OWNER=that timelock, then broadcast only after
#    bytecode/address review.
# 4. PrepareGovernanceOwnership.s.sol generates Safe schedule/execute payloads;
#    schedule, wait >=48h, execute, then run the service preflight.

OWNER=0xREPLACE_WITH_TIMELOCK
GUARDIAN=0xREPLACE_WITH_SAFE
TREASURY=0xREPLACE_WITH_SAFE
DEPLOY_MOCK_ADAPTER=false
DEPLOY_BLACKHOLE_ADAPTER=true

LFJ_LB_ROUTER=0xb4315e873dBcf96Ffd0acd8EA43f689D8c20fB30
LFJ_LB_QUOTER=0xd76019A16606FDa4651f636D9751f500Ed776250
BLACKHOLE_ROUTER=0xe946A9f39312E2346BA79DAb865B0e9A74f2F981
BLACKHOLE_HELPER=0x53D569BC4B37ADbBDB6ab447D92ADf42514AE480
BLACKHOLE_WAVAX_USDC_POOL=0x41100C6D2c6920B10d12Cd8D59c8A9AA2eF56fC7
BLACKHOLE_USDC_USDT_POOL=0x859592A4A469610E573f96Ef87A0e5565F9a94c8
PHARAOH_SWAP_ROUTER=0xc8B8fCbDb5C019D7802fFb0b39603395D7d3915c
PHARAOH_QUOTER_V2=0xB7297301b7CC659BB96D51754643A0Df6eEA2138

ALLOWED_TOKEN_0=0xB31f66AA3C1e785363F0875A1B74E27b85FD66c7
ALLOWED_TOKEN_1=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
ALLOWED_TOKEN_2=0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7

# Economic policy must be explicitly approved for mainnet. These are example
# values matching the current 70% maker surplus share and zero protocol fee.
