# Economic policy must be explicitly approved for mainnet. These are example
# values matching the current 70% maker surplus share and zero protocol fee.
MAKER_SURPLUS_BPS=7000
PROTOCOL_FEE_BPS=0

# Temporary bootstrap alternative when no Safe exists. Keep OWNER as the
# 48-hour timelock, set PROPOSER, EXECUTOR, GUARDIAN and TREASURY to the same
# deployer EOA, and set this exact acknowledgement. Remove it after migrating
# every role and guardian to a >=2-threshold Safe.
# BOOTSTRAP_EOA_GOVERNANCE_ACK=I_ACCEPT_SINGLE_EOA_GOVERNANCE_RISK
